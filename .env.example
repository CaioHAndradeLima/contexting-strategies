# Live measure — pick ONE provider:
# - cursor (local Cursor agent): CURSOR_API_KEY from https://cursor.com/dashboard/integrations
# - openai: OPENAI_API_KEY
CURSOR_API_KEY=
OPENAI_API_KEY=

# openai | cursor (if unset: cursor when CURSOR_API_KEY is set, else openai)
CONTEXT_LAB_LLM_PROVIDER=cursor
CONTEXT_LAB_CURSOR_MODEL=composer-2.5

# Optional overrides (CLI flags take precedence)
CONTEXT_LAB_LIVE_LLM=false
CONTEXT_LAB_ANSWER_MODEL=gpt-6-luna
CONTEXT_LAB_JUDGE_MODEL=gpt-6-luna
CONTEXT_LAB_MAX_LLM_CALLS=100

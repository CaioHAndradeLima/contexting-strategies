        },
        "naive_retrieval_order": {
          "min_evidence_coverage": 0.5,
          "max_unauthorized_leak": 1.0
        }
      }
    },
    "ci-pipeline-only": {
      "description": "Smoke profile for the production-style pipeline assembler.",
      "strategies": ["pipeline_acl_dedupe_score_diverse"],
      "candidate_k": 10,
      "budget_tokens": 180,
      "apply_heuristic_rerank": true,
      "gates": {
        "pipeline_acl_dedupe_score_diverse": {
          "min_evidence_coverage": 0.6,
          "max_unauthorized_leak": 0.0
